#include "resource.h"
#include <windows.h>

IDI_APP_ICON ICON "app.ico"
IDR_HARBOR_ART RCDATA "harbor.png"
#ifdef AERO_EMBED_MANIFEST
1 24 "app.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,3,0,0
PRODUCTVERSION 1,3,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AeroProject"
            VALUE "FileDescription", "Aero Launcher"
            VALUE "FileVersion", "1.3.0"
            VALUE "InternalName", "AeroLauncher"
            VALUE "OriginalFilename", "Aero Launcher.exe"
            VALUE "ProductName", "Aero Launcher"
            VALUE "ProductVersion", "1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
