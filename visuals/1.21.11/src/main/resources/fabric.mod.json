{
  "schemaVersion": 1,
  "id": "aerovisuals",
  "version": "${version}",
  "name": "AeroVisuals",
  "description": "Premium client-side visual and cosmetic suite for Minecraft ${minecraft_version}.",
  "authors": [
    "AeroVisuals"
  ],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "icon": "assets/aerovisuals/cosmic-logo.png",
  "entrypoints": {
    "client": [
      "net.aero.visuals.AeroVisuals"
    ]
  },
  "mixins": [
    "aerovisuals.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
